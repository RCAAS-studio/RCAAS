# Development values. For production use deploy/web.env.example and rebuild
# after setting the real HTTPS origin for both public URLs.
# Node API base URL the Next app calls (see src/lib/api.ts).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Separate hosts (src/lib/hosts.ts, src/proxy.ts). Leave all three empty to keep everything on
# NEXT_PUBLIC_SITE_URL. Set all three together; the API needs the same values (STUDIO_URL, TOURS_URL,
# SITES_DOMAIN), and the reverse proxy must keep the Host header and send /api/* to the API on every host.
NEXT_PUBLIC_STUDIO_URL=
NEXT_PUBLIC_TOURS_URL=
NEXT_PUBLIC_SITES_DOMAIN=
# Server-side fetches straight to the API (not through the public name), e.g. http://127.0.0.1:4000.
API_INTERNAL_URL=
# Old-link redirects are 307 until this is 308 (browsers keep a 308 for good: set it once links are checked).
LEGACY_REDIRECT_STATUS=

# Only set this for a sub-path deploy (e.g. GitHub Pages). Empty = root.
NEXT_PUBLIC_BASE_PATH=
