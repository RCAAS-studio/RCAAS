# Copy to C:/RCAAS/config/api.env. Restrict access as described in README.md.
# Use literal KEY=value lines; quote values containing spaces. No shell expansion.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=https://example.com
DATA_DIR=C:/RCAAS/data
ASSET_DRIVER=local
ASSET_DIR=C:/RCAAS/assets

# Generate EACH independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-session
EMBED_TOKEN_SECRET=change-me-embed
EDITOR_PASSWORD=change-me-team-access-code

# Blank preserves current file accounts. PostgreSQL moves accounts ONLY.
DATABASE_URL=
DATABASE_CA_FILE=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Optional backup tool path if PostgreSQL is enabled (match server major version).
# PG_DUMP_EXE=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe

# Configure and verify these before promising enquiry/reset email delivery.
RESEND_API_KEY=
LEADS_FROM=
LEADS_TO=

# Optional R2/S3: populate and verify model paths BEFORE selecting s3 above.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_PREFIX=assets/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional features remain disabled until configured (see server/.env.example).
SMS_TOKEN=
SMS_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
ANTHROPIC_API_KEY=
DEMO_ENGINE=0
