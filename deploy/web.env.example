# Public settings only. Read at BUILD time and by the Next service.
# Replace example.com everywhere. No /api suffix and no trailing slash.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_API_URL=https://example.com
NEXT_PUBLIC_BASE_PATH=
NEXT_OUTPUT_EXPORT=
NEXT_DIST_DIR=.next
NEXT_TELEMETRY_DISABLED=1
