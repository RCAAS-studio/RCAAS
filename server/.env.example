PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Separate hosts: the same values as the site's NEXT_PUBLIC_STUDIO_URL / _TOURS_URL / _SITES_DOMAIN.
# Empty keeps every emailed link on CLIENT_ORIGIN (src/publicUrls.js).
STUDIO_URL=
TOURS_URL=
SITES_DOMAIN=

# Shared editor password until real accounts exist (Postgres "not started" per CLAUDE.md).
EDITOR_PASSWORD=change-me

# Long random strings in real environments — these sign session + embed tokens.
SESSION_SECRET=change-me-too
EMBED_TOKEN_SECRET=change-me-as-well

# Studio accounts in Postgres (src/usersStore.js). Unset: JSON files in DATA_DIR/users.
# Supabase: Project → Connect → "Session pooler" string (IPv4), with your DB password.
# Tables go in the `app` schema (not exposed by Supabase's Data API), created on start.
# Copy existing accounts in once with: npm run db:import-users
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# The provider's CA certificate, so TLS is verified (Supabase: Database → SSL configuration).
# DATABASE_CA_FILE=./prod-ca-2021.crt
# Bound connection waits and SQL statements, including health checks (milliseconds).
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# Where uploaded splats are kept (src/storage.js).
#   local  this PC's disk (ASSET_DIR). Only this PC can show them.
#   s3     one cloud bucket (Cloudflare R2, Backblaze B2, AWS S3, …) that every
#          PC and the hosted API share, so a splat uploaded anywhere shows
#          everywhere. Copy existing uploads up with: npm run assets:push
ASSET_DRIVER=local
ASSET_DIR=./src/data/assets


